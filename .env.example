# Docker network created by the main Firefly III stack.
FIREFLY_DOCKER_NETWORK=fireflyiii_firefly_iii

# Reach Firefly III over the shared Docker network.
FIREFLY_URL=http://firefly_iii_app:8080

# Browser-facing Firefly III URL used for "Open in Firefly III" links.
FIREFLY_UI_URL=http://localhost:8080

# Put secrets in .env.local so they stay out of git.
FIREFLY_PERSONAL_TOKEN=

# Local host port for the health endpoint and optional UI.
AI_CATEGORIZER_PORT=3202

# Default ChatGPT/Codex OAuth flow.
OPENAI_AUTH_MODE=codex_oauth
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CODEX_AUTH_FILE=/data/secrets/openai_codex_auth.json
OPENAI_CODEX_BASE_URL=
TAG_PREFIX=ai
ENABLE_UI=true
APP_STATE_FILE=/data/state/app-state.json
BACKFILL_DEFAULT_MAX_TRANSACTIONS=100
BACKFILL_MAX_TRANSACTIONS=1000
BACKFILL_PAGE_SIZE=100
